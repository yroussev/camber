{
 "id": "synthetic-g36-vav-fleet",
 "title": "Synthetic G36 VAV fleet: trim-and-respond resets and their zones (generated by CAMBER)",
 "summary": "SYNTHETIC, generated locally by CAMBER (no download, no real building): a VAV air handler with six single-duct reheat boxes under Guideline 36 trim-and-respond resets, hourly for three weeks of spring, as eight air handlers that differ in one way each: a healthy fleet, a rogue zone dragging the SAT reset down, a blocked box holding duct static up, a capped supply fan starving every box, a reset that ignores its requests, single-maximum reheat, overlapping heating and cooling setpoints, and a warm zone that is not quite a rogue. The air handlers trend their SAT and duct-static setpoints with the reset requests they summed; each box its space temperature and setpoints, airflow, active and minimum airflow setpoints, damper, reheat valve and heating and cooling loops.",
 "teaches": [
  "the G36 zone-fleet checks, which no open dataset can exercise: the rogue-zone census, cohort starvation and reset effectiveness",
  "why a reset that does exactly what its requests ask can still serve one bad zone at everyone else's expense",
  "how to tell a starved cohort behind a capped fan from one behind a reset that ignores its requests",
  "reheat that is not minimized and simultaneous heating and cooling, per box and across the fleet"
 ],
 "publisher": "CAMBER (generated locally by the user's copy)",
 "citation": "CAMBER synthetic dataset synthetic-g36-vav-fleet, generator g36_vav_fleet (camber.datasets._synthetic_g36_vav_fleet), seed 144. Generated data, not measurements from any building.",
 "dois": [],
 "landing_url": "https://github.com/yroussev/camber/blob/main/docs/DATASETS.md#synthetic-datasets",
 "licence": "Apache-2.0",
 "access": "open",
 "attribution_required": false,
 "verified_on": "2026-10-17",
 "kind": "synthetic",
 "generator": {
  "name": "g36_vav_fleet",
  "seed": 144
 },
 "labeled_faults": true,
 "timezone": "naive generated clock (no DST); hourly samples from 2025-04-28 (a Monday) for 21 days",
 "requires_extras": [],
 "equipment": "8 VAV air handlers, each with 6 single-duct reheat boxes (56 pieces of equipment)",
 "labels": {
  "targets": {
   "sat_reset_effectiveness": [
    "reset_not_responding"
   ],
   "static_reset_effectiveness": [
    "reset_not_responding"
   ],
   "reheat_minimization_g36": [
    "reheat_not_minimized",
    "heating_cooling_overlap"
   ],
   "unmet_setpoint_hours": [
    "starved_by_air_handler",
    "rogue_zone"
   ],
   "airflow_tracking": [
    "starved_by_air_handler",
    "rogue_zone"
   ]
  },
  "fault_types": {
   "reset_not_responding": "the air handler's trim-and-respond logic ignores its requests and only trims: the SAT setpoint sits at its 65 F trim end, the duct-static setpoint trims to 0.1 in. w.c. within two hours of each morning's start",
   "starved_cohort": "the supply fan is capped and the duct static cannot rise past 0.06 in. w.c.: every box is short of air at once (labelled on the air handler; the cohort-starvation rules find it, and they are fleet rules, not scored per equipment)",
   "rogue_zone": "one box that drags a reset for its whole air handler: an equipment room no box can cool (SAT), or a blocked inlet that gets 40 % of its minimum airflow with its damper wide open (duct static, the north box VAV4 since generator version 3) (the rogue-zone censuses find them; unmet_setpoint_hours and airflow_tracking score them per box, and the blocked box stays comfortable, so unmet_setpoint_hours misses it)",
   "reheat_not_minimized": "a single-maximum heating sequence: the box reheats at 80 % of its cooling maximum airflow instead of at its minimum",
   "heating_cooling_overlap": "the zone's heating setpoint (74 F) is above its cooling setpoint (73 F) while the fan runs, so the reheat valve and the cooling airflow fight",
   "starved_by_air_handler": "a box behind AHU__starved or AHU__not_responding: short of air and warm because its air handler cannot or will not serve it, not because of the box (generator version 3, 0.108; unmet_setpoint_hours and airflow_tracking find them, and the RCx report links them to their air handler's finding)"
  }
 },
 "files": [
  {
   "name": "g36_vav_fleet.csv"
  }
 ],

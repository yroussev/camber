  "fault_types": {
   "sat_too_warm": "the cooling coil cannot make supply air below 63 F (its valve wide open): the supply air runs above the setpoint the SAT reset asks for (G36 FC13 in g36_afdd)",
   "static_too_low": "a weak supply fan makes at most 0.35 in. w.c. at full speed: the duct static runs below its setpoint with the fan flat out (G36 FC1 in g36_afdd)",
   "sat_too_cold": "the SAT reset is disabled and the setpoint fixed at 55 F: supply air held cold with no upward reset (supply_air_reset)",
   "warm_by_air_handler": "a box behind AHU__warm_sat that the warm supply air leaves too warm: a symptom whose cause is upstream (the north box VAV4 is not affected and not labelled)",
   "starved_by_air_handler": "a box behind AHU__low_static that its weak fan leaves short of air (and warm): a symptom whose cause is upstream (the north box VAV4, which needs little air, is not affected and not labelled)",
   "stuck_damper": "VAV3__one_bad_box's damper is stuck at 30 %: that box alone is short of air and warm, under a healthy air handler",
   "reheat_not_minimized": "a single-maximum heating sequence on VAV2 and VAV4 of AHU__cold_sat: they reheat at 60 % of their cooling maximum airflow instead of at the minimum"
  }
 },

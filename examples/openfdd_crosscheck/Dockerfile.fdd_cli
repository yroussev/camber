# open-fdd's SQL rule engine CLI (crate fdd_cli, binary openfdd_cli), built from the pinned commit.
# Used by run_crosscheck.py --sql-image; the harness runs it with --network none and read-only
# data mounts. Nothing from open-fdd is copied into CAMBER: the source is fetched at build time.
#
#   docker build -f examples/openfdd_crosscheck/Dockerfile.fdd_cli -t camber-crosscheck/fdd_cli:32a6d44 .
#   docker builder prune   # afterwards, to drop the Rust build cache
FROM rust:1.95-bookworm AS build
ARG OPENFDD_COMMIT=32a6d4479abed81f9d6d0ff426260cc8ad8e30e2
RUN apt-get update \
  && apt-get install -y --no-install-recommends clang libclang-dev build-essential pkg-config libssl-dev git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init -q . \
  && git remote add origin https://github.com/bbartling/open-fdd \
  && git fetch -q --depth 1 origin "$OPENFDD_COMMIT" \
  && git checkout -q FETCH_HEAD
RUN cargo build --release --locked -p fdd_cli

FROM debian:bookworm-slim
ARG OPENFDD_COMMIT=32a6d4479abed81f9d6d0ff426260cc8ad8e30e2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/openfdd_cli /usr/local/bin/openfdd_cli
COPY --from=build /src/sql_rules /opt/open-fdd/sql_rules
COPY --from=build /src/rule_tuning /opt/open-fdd/rule_tuning
LABEL org.opencontainers.image.source="https://github.com/bbartling/open-fdd" \
      org.opencontainers.image.revision="$OPENFDD_COMMIT"
ENTRYPOINT ["/usr/local/bin/openfdd_cli"]

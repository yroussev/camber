              },
              "required": [
                "facility"
              ],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            }
          }
        ]
      }
    }

  {
    "note": "tools/list: no resultType, no cache hints; the array-output tool has no outputSchema",
    "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tools/list"
    },
    "raw": false,
    "expect": {
      "jsonrpc": "2.0",
      "id": 5,
      "result": {
        "tools": [
          {
            "name": "boom",
            "title": "Boom",
            "description": "Always fails inside.",
            "inputSchema": {
              "type": "object"
            },
            "outputSchema": {
              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            }
          },
          {
            "name": "facilities",
            "title": "Facilities",
            "description": "List the facilities this server may read.",
            "inputSchema": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "facilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "facilities"
              ]
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            }
          },
          {
            "name": "ids",
            "title": "Ids",
            "description": "A result that is a JSON array.",
            "inputSchema": {
              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            }
          },
          {
            "name": "noisy",
            "title": "Noisy",
            "description": "Writes to stdout while it runs.",
            "inputSchema": {
              "type": "object"
            },
            "outputSchema": {
              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            }
          },
          {
            "name": "rows",
            "title": "Rows",
            "description": "Up to three rows of one facility.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "facility": {
                  "type": "string"
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
